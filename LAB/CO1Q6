from collections import deque

def vacuum_cleaner():
    # State = (left_room, right_room, vacuum_position)
    # 0 = Dirty, 1 = Clean
    # position: 0 = Left, 1 = Right

    start = (0, 0, 0)

    queue = deque([(start, [])])
    visited = {start}

    while queue:
        state, path = queue.popleft()

        left, right, pos = state

        if left == 1 and right == 1:
            print("Solution:")
            for action in path:
                print(action)
            return

        if pos == 0:
            actions = [
                ((1, right, pos), "Clean Left"),
                ((left, right, 1), "Move Right")
            ]
        else:
            actions = [
                ((left, 1, pos), "Clean Right"),
                ((left, right, 0), "Move Left")
            ]

        for new_state, action in actions:
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + [action]))


vacuum_cleaner()
