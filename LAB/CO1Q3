from collections import deque

def water_jug():
    jug1 = 4
    jug2 = 3
    target = 2

    queue = deque([((0, 0), [])])
    visited = {(0, 0)}

    while queue:
        (a, b), path = queue.popleft()

        if a == target or b == target:
            print("Solution:")
            for state in path + [(a, b)]:
                print(state)
            return

        states = [
            (jug1, b),              # Fill jug 1
            (a, jug2),              # Fill jug 2
            (0, b),                 # Empty jug 1
            (a, 0),                 # Empty jug 2
            (a - min(a, jug2-b), b + min(a, jug2-b)),
            (a + min(b, jug1-a), b - min(b, jug1-a))
        ]

        for state in states:
            if state not in visited:
                visited.add(state)
                queue.append((state, path + [(a, b)]))

    print("No solution.")


water_jug()
